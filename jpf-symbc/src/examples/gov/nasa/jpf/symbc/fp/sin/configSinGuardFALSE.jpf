classpath = /home/salmane/IdeaProjects/java-ranger/jpf-symbc/build/examples
target = gov.nasa.jpf.symbc.fp.sin.TestSinGuardFALSE
symbolic.method=gov.nasa.jpf.symbc.fp.sin.TestSinGuardFALSE.test(sym#sym)
jvm.insn_factory.class=gov.nasa.jpf.symbc.SymbolicInstructionFactory
recursiveDepth= 200
listener=.symbc.VeritestingListener
#symbolic.mantissa=24
veritestingMode=5
symbolic.dp=z3bitvector
symbolic.min_int=-2147483648
symbolic.max_int=2147483647
symbolic.min_double=-10000.0
symbolic.max_double=10000.0
symbolic.min_float=-10000.0
symbolic.max_float=10000.0
symbolic.bvlength=64
search.depth_limit=20
symbolic.strings=false
symbolic.lazy=on
symbolic.jrarrays=true
singlePathOptimization=true
symbolic.fp=true
symbolic.debug=true
search.multiple_errors=true
